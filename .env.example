# ── Required ─────────────────────────────────────────────────────────────────

# GitHub fine-grained PAT with "Public Repositories (read-only)" access.
# Never expose this to the client — it stays server-side only.
GITHUB_TOKEN=ghp_your_token_here

# SQLite database file path (relative to repo root).
# Prisma will create this file automatically on first run.
DATABASE_URL=file:./tracker.db

# ── Optional ──────────────────────────────────────────────────────────────────

# Override the default 50-lookups/month global cap.
# MONTHLY_CAP=50

# Slack incoming webhook URL for the weekly digest script.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...
